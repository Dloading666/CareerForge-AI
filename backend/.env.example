APP_ENV=development
APP_NAME=智培职联 AI 智能体平台
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./zhipei_auth.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=  # REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=123456
ADMIN_BOOTSTRAP_NAME=平台管理员
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_SSL=false
SMTP_USE_TLS=true
EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

SKILL_STORAGE_DIR=./data/skills
SKILL_MAX_CONTENT_BYTES=200000

APP_ENV=production
APP_NAME=CareerForge AI 智能体平台
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=https://your-domain.com

DATABASE_URL=mysql+pymysql://zhipei:zhipei123456@mysql:3306/zhipei_agent?charset=utf8mb4
REDIS_URL=redis://:redis123456@redis:6379/0

JWT_SECRET_KEY=your-random-64-char-secret-key-here
API_KEY_ENCRYPTION_KEY=your-fernet-encryption-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@your-domain.com
ADMIN_BOOTSTRAP_PASSWORD=your-admin-password
ADMIN_BOOTSTRAP_NAME=平台管理员

SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-email@qq.com
SMTP_USE_SSL=false
SMTP_USE_TLS=true

EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Dify
DIFY_API_BASE_URL=http://your-dify-server/v1
# DIFY_INTERVIEW_AGENT_KEY=app-xxx
# DIFY_MATCH_AGENT_KEY=app-xxx
